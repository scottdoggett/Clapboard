# Clapboard Environment Variables
# Copy this file to .env and fill in your values

# Convex deployment URL (get this from your Convex dashboard)
CONVEX_URL=https://your-deployment.convex.cloud

# Optional: API keys for direct rating source access (if not proxied through Convex)
# OMDB_API_KEY=your_omdb_api_key
# TMDB_API_KEY=your_tmdb_api_key

# Optional: Clerk authentication (for Phase 4 user accounts)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
