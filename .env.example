# Clapboard Environment Variables
# Copy this file to .env and fill in your values

# Convex deployment URL (get this from your Convex dashboard).
# Read at build time and baked into the extension bundle. You can also set or
# override it at runtime from the Clapboard popup's Settings panel.
CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# Backend secrets
#
# The OMDb key is NOT set here — it lives in the Convex deployment so it never
# ships inside the extension. Set it once with:
#
#   npx convex env set OMDB_API_KEY <your_key>
#
# Get a free key at https://www.omdbapi.com/apikey.aspx
#
# The same goes for the Anthropic key that Phase 3 review scoring needs. It is
# optional — scoring is off by default behind FEATURES.AI_SCORES_ENABLED.
#
#   npx convex env set ANTHROPIC_API_KEY <your_key>
#
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Accounts
#
# There is nothing to set here. Auth is Convex Auth with the password
# provider, chosen precisely because it needs no third-party account — sign-up
# runs entirely against your own deployment. Its signing keys live in the
# deployment env and are generated for you by:
#
#   npx @convex-dev/auth
#
# Signing in is optional. Ratings, awards and your library all work without an
# account; signing in only makes the library survive a reinstall and follow
# you to another browser.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional enrichment, also set on the deployment rather than here
#
#   npx convex env set MDBLIST_API_KEY <key>   # adds Letterboxd ratings
#   npx convex env set TMDB_API_KEY <key>      # better artwork and metadata
#
# Both are off unless a key is present, and neither can fail a lookup.
# ---------------------------------------------------------------------------
